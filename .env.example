# database-mcp 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# 数据库类型（必填）
# 可选值：mysql, mariadb, tidb, postgresql, sqlite, oracle, sqlserver
DB_TYPE=mysql

# MySQL/MariaDB/TiDB/PostgreSQL/Oracle/SQL Server 配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_username
DB_PASSWORD=your_password
DB_NAME=your_database

# SQLite 配置（仅 SQLite 需要，其他数据库可忽略）
# DB_FILE=/path/to/your.db
